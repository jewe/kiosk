#!/usr/bin/env bash
# kioskctl — control CLI for the kiosk system.
set -euo pipefail
source /opt/kiosksystem/lib/common.sh
LOG_TAG="kioskctl"

usage() {
    cat <<'U'
Usage: kioskctl <command> [args]        kioskctl help <command> for details and examples

Status and health
  status [--json]            summary of this kiosk (apps, display, services, memory, disks)
  doctor                     check every component
  history [N]                last N metric lines from the journal (default 20)
  metrics                    collect metrics now (JSON)
  heartbeat                  send a heartbeat now
  version                    system version and git revision

Configuration
  apply                      validate kiosk.yaml and apply apps, display, services, extensions
  app list|start|stop|restart|logs|update [name] [repo]
  display                    re-apply screen layout and touch mapping now
  extension list|update [id]|id <name>   Chrome extensions (config chrome.extensions)
  secrets git-key [label]|tunnel-key|list   deploy keys and the tunnel key
  update                     git pull system repo, re-run setup, re-apply

Persistence
  storage status|init [SIZE] persistent volume for /opt/kiosk (default 20G)
  mount <rw|locked|data|data+journal>   set persistence mode (reboot required)

On site
  wifi status|scan|connect <ssid> [psk] [--hidden]|forget|on|off
  usb list|mount [dev]|umount  USB sticks: list, mount at /media/usb, unmount
  files [dir]                open caja on the kiosk screen with a visible cursor
  cursor show|hide           show or hide the mouse pointer
  devmode on|off             escape hotkeys in the session (Ctrl+Alt+T terminal)
  screenshot [file]|--telegram [caption]   save a screenshot / send it to Telegram
  schedule on|off|sync       run a scheduler action now

Tests
  test stress [min] [eps]    simulate usage, sample memory (tests/stress.sh)
  bench info|gpu|motionmark|ab "<flags A>" "<flags B>"   benchmarks (tests/bench.sh)
U
}

cmd_help() {
    local c="${1:-}"
    case "$c" in
        "") usage ;;
        status) cat <<'H'
kioskctl status [--json]
  One screen with everything about this kiosk: version (and commits behind origin), OS and kernel,
  upgradable packages and reboot-required flag, persistence mode, session state, apps with their repos
  (commit, age, size, lfs, failed syncs), outputs, enabled services, WLAN, memory and disk space. --json prints the same as one
  JSON object (the heartbeat sends this).
H
;;      doctor) cat <<'H'
kioskctl doctor
  Runs one check per component (config, user, X, session, apps, timers, persistence, extensions) and
  prints ok/FAIL per line. Exit code 1 when anything failed. "tty1 is the active console" fails when a
  text console is active: switch back with chvt 1 or kioskctl display.
H
;;      history|metrics|heartbeat) cat <<'H'
kioskctl history [N]        last N lines of the metrics the monitor timer writes (journal tag kiosk-monitor)
kioskctl metrics            collect the metrics now and print the JSON (temperatures, load, memory, disks, restarts)
kioskctl heartbeat          send the metrics to services.monitoring.url now (needs the token in secrets/monitoring.env)
  Benchmark results are in the journal too: journalctl -t kiosk-bench
H
;;      apply) cat <<'H'
sudo kioskctl apply
  Reads /opt/kiosk/config/kiosk.yaml and makes the system match it: app env files and units, Chrome
  options and extensions, display layout (live when X runs), services (performance, audio, wifi, tunnel,
  usb, security, scheduler, telegram, monitoring). Restarts the app units. The persistence mode is only
  reported, switch it with kioskctl mount. Reference of every key: docs/config.md
H
;;      app) cat <<'H'
kioskctl app list                      apps from the config with unit name and state
kioskctl app start|stop|restart <name>
kioskctl app logs <name>               last 100 journal lines of the unit
sudo kioskctl app update <name> [repo] pull the repos of a static app now (repo = app or a data name, default all)
  Units are kiosk-<type>@<name>.service under kiosk.target. Example: sudo kioskctl app restart menu
H
;;      display) cat <<'H'
kioskctl display
  Re-applies display.outputs (xrandr) and the touch mapping on the running X server and switches back to
  tty1 if a text console was active. Prints the connected outputs with their geometry.
H
;;      extension|ext) cat <<'H'
kioskctl extension list            published extensions: id, version, served by nginx, source
sudo kioskctl extension update [id]   download Web Store extensions again (then: kioskctl apply)
kioskctl extension id <name>       ID of a private extension (derived from its key)
  Configure in kiosk.yaml under chrome.extensions (name: for a folder in /opt/kiosk/extensions/src,
  id: for a Web Store extension) and run sudo kioskctl apply. Details: docs/extensions.md
H
;;      secrets) cat <<'H'
sudo kioskctl secrets git-key [label]   create or show a deploy key (secrets/git/<label> or id_ed25519); add it
                                        read-only on GitHub. One deploy key per repo: use <app>-app and <app>-data
sudo kioskctl secrets tunnel-key        show the public key of the SSH tunnel
sudo kioskctl secrets list              list every public key
  Secrets live in /opt/kiosk/secrets (root, 0600). Copy them to or from your machine with tools/secrets.sh.
H
;;      update) cat <<'H'
sudo kioskctl update
  git pull in /opt/kiosksystem, re-run setup.sh, then kioskctl apply. Refused while the root is overlaid
  (locked or data mode): run sudo kioskctl mount rw, reboot, update, then set the mode again.
H
;;      storage) cat <<'H'
kioskctl storage status           is /opt/kiosk a separate volume, size and usage
sudo kioskctl storage init [SIZE] create the LVM volume for /opt/kiosk (default 20G), move the data, add to fstab
  Needed for data and data+journal mode. Done by the autoinstall on new devices.
H
;;      mount) cat <<'H'
sudo kioskctl mount <mode>; reboot
  rw            everything writable (setup, updates)
  data          root read-only overlay, /opt/kiosk persistent (config, secrets, app repos, bench results)
  data+journal  like data, plus the journal on /opt/kiosk/logs/journal
  locked        everything volatile, the device boots to the same state every time
  The mode is written to the kernel command line via a GRUB drop-in; kioskctl works inside an active
  overlay through a chroot into the real root. Current mode: kioskctl status.
H
;;      wifi) cat <<'H'
kioskctl wifi status                        wifi device, link, signal, IP
sudo kioskctl wifi scan                     networks in range
sudo kioskctl wifi connect <ssid> [psk] [--hidden]   join now; asks for the key when omitted. Profile "onsite",
                                            priority below the service WLANs from network.wifi
sudo kioskctl wifi forget                   remove the onsite profile
sudo kioskctl wifi on|off                   radio
  Service WLANs for every site go into network.wifi + secrets/wifi.env instead (kioskctl apply).
H
;;      usb) cat <<'H'
sudo kioskctl usb list            USB block devices
sudo kioskctl usb mount [dev]     mount the first USB partition (or dev) at /media/usb, owned by the kiosk user
sudo kioskctl usb umount          sync and unmount
  Blocked while security.disable_usb_storage is on. On-screen alternative: kioskctl files
H
;;      files|cursor) cat <<'H'
sudo kioskctl files [dir]         open caja on the kiosk screen (default /opt/kiosk) with the cursor visible;
                                  needs tools/install.sh mate. Close it with Ctrl+Alt+Q in dev mode
sudo kioskctl cursor show|hide    show or hide the mouse pointer (unclutter)
H
;;      devmode) cat <<'H'
sudo kioskctl devmode on|off
  on: openbox hotkeys Ctrl+Alt+T (terminal), Ctrl+Alt+F (files), Ctrl+Alt+C (Chrome window), Ctrl+Alt+Q
  (close window), Alt+Tab, Alt+drag; cursor visible. off: production, no hotkeys. See docs/shortcuts.md
H
;;      screenshot) cat <<'H'
sudo kioskctl screenshot [file]              PNG of the whole screen (default /opt/kiosk/data/screenshots/<ts>.png)
sudo kioskctl screenshot --telegram [caption] send it to services.telegram.chat_id (token in secrets/telegram.env)
  The kiosk-telegram.timer sends one at boot and every services.telegram.interval when enabled.
H
;;      schedule) cat <<'H'
sudo kioskctl schedule on|off|sync
  Run the scheduler action now (off_action: screen = DPMS off, apps = stop apps, shutdown). sync applies
  the state the schedule says for the current time. Times: schedule: in kiosk.yaml, timers from apply.
H
;;      test) cat <<'H'
sudo kioskctl test stress [minutes] [events/s]
  Random clicks, drags, scrolls and keys on the kiosk screen (xdotool), memory sampled every 30 s to
  /opt/kiosk/data/stress/*.csv. PASS = no app restarts and memory growth under 10 %. Default 10 min, 5 ev/s.
H
;;      bench) cat <<'H'
sudo kioskctl bench info              GPU, driver, VA-API, clocks, and Chrome's chrome://gpu feature status
sudo kioskctl bench gpu               glmark2 fullscreen, about 8 minutes
sudo kioskctl bench motionmark        MotionMark with the production Chrome flags, about 6 minutes, score via DevTools
sudo kioskctl bench ab "" "--enable-features=Vulkan" [rounds]   two flag sets alternating, prints both medians
  The apps are stopped during a run. Results: /opt/kiosk/data/bench/, journal tag kiosk-bench.
  Levers and reference scores: docs/performance.md
H
;;      version) echo "kioskctl version    VERSION file and git revision of /opt/kiosksystem" ;;
        help) echo "kioskctl help [command]   this overview, or details of one command" ;;
        *) echo "unknown command '$c'"; usage; return 1 ;;
    esac
}

XENV=(DISPLAY=:0 XAUTHORITY="/home/${KIOSK_USER}/.Xauthority")

# ---------- helpers ----------
app_names() { yq -r '.apps[]?.name' "$KIOSK_CONFIG" 2>/dev/null || true; }
app_unit()  { local n="$1" t; t="$(yq -r ".apps[] | select(.name==\"$n\") | .type" "$KIOSK_CONFIG")"; echo "kiosk-${t}@${n}.service"; }
persistence_mode() { cat /etc/kiosk-persistence 2>/dev/null || echo rw; }
x_running() { env "${XENV[@]}" xset q >/dev/null 2>&1; }
as_kiosk_x() { sudo -u "$KIOSK_USER" env "${XENV[@]}" "$@"; }

# render_app_env <index>   Prints APP_<KEY>=value for every scalar key of apps[index],
# plus defaults for screen and geometry. Lists and maps are skipped.
render_app_env() {
    local i="$1" key val
    echo "APP_SCREEN=primary"
    echo "APP_GEOMETRY=fullscreen"
    while read -r key; do
        [ -n "$key" ] || continue
        [[ "$key" =~ ^[a-z0-9_]+$ ]] || { warn "apps[$i]: key '$key' ignored (use a-z, 0-9, _)"; continue; }
        case "$(yq -r ".apps[$i].${key} | type" "$KIOSK_CONFIG")" in
            array|object) continue ;;
        esac
        val="$(cfg ".apps[$i].${key}")"
        val="${val//\\/\\\\}"; val="${val//\"/\\\"}"
        echo "APP_${key^^}=\"${val}\""
    done < <(yq -r ".apps[$i] | keys | .[]" "$KIOSK_CONFIG")
    render_app_data "$i"
}

# render_app_data <index>   Data repos of a static app: APP_DATA_COUNT and APP_DATA_<n>_NAME|REPO|BRANCH|SUBDIR|URL|LFS|ON_CHANGE.
# Source: apps[i].data[] (up to 5), or the legacy keys data_repo/data_branch/data_subdir/data_url/on_data_change as entry "data".
render_app_data() {
    local i="$1" n j k v name names=() out=0 q
    q() { v="${1//\\/\\\\}"; v="${v//\"/\\\"}"; printf '"%s"' "$v"; }
    n="$(cfg ".apps[$i].data | length" 0)"
    if [ "$n" = 0 ] && [ -n "$(cfg ".apps[$i].data_repo")" ]; then
        echo "APP_DATA_COUNT=1"
        echo "APP_DATA_0_NAME=\"data\""
        echo "APP_DATA_0_REPO=$(q "$(cfg ".apps[$i].data_repo")")"
        echo "APP_DATA_0_BRANCH=$(q "$(cfg ".apps[$i].data_branch" main)")"
        echo "APP_DATA_0_SUBDIR=$(q "$(cfg ".apps[$i].data_subdir")")"
        echo "APP_DATA_0_URL=$(q "$(cfg ".apps[$i].data_url" /data)")"
        echo "APP_DATA_0_LFS=\"false\""
        echo "APP_DATA_0_ON_CHANGE=$(q "$(cfg ".apps[$i].on_data_change" reload)")"
        return
    fi
    [ "$n" -le 5 ] || { warn "apps[$i]: only the first 5 data repos are used"; n=5; }
    for ((j=0; j<n; j++)); do
        name="$(cfg ".apps[$i].data[$j].name")"
        [[ "$name" =~ ^[a-z0-9_-]+$ ]] || { warn "apps[$i].data[$j]: name '$name' must be [a-z0-9_-]"; continue; }
        [[ " ${names[*]:-} " == *" $name "* ]] && { warn "apps[$i].data: duplicate name '$name'"; continue; }
        [ -n "$(cfg ".apps[$i].data[$j].repo")" ] || { warn "apps[$i].data[$j] '$name': repo missing"; continue; }
        names+=("$name")
        echo "APP_DATA_${out}_NAME=$(q "$name")"
        echo "APP_DATA_${out}_REPO=$(q "$(cfg ".apps[$i].data[$j].repo")")"
        echo "APP_DATA_${out}_BRANCH=$(q "$(cfg ".apps[$i].data[$j].branch" main)")"
        echo "APP_DATA_${out}_SUBDIR=$(q "$(cfg ".apps[$i].data[$j].subdir")")"
        echo "APP_DATA_${out}_URL=$(q "$(cfg ".apps[$i].data[$j].url" "/$name")")"
        echo "APP_DATA_${out}_LFS=$(q "$(cfg ".apps[$i].data[$j].lfs" false)")"
        echo "APP_DATA_${out}_ON_CHANGE=$(q "$(cfg ".apps[$i].data[$j].on_change" reload)")"
        out=$((out+1))
    done
    echo "APP_DATA_COUNT=$out"
}

# cursor_show / cursor_hide: the kiosk session hides the pointer (unclutter-xfixes); dev tools need it
cursor_show() {
    # -x cannot match names longer than 15 characters; match the start of the command line instead
    pkill -u "$KIOSK_USER" -f '^unclutter-xfixes' 2>/dev/null || true
    sudo -u "$KIOSK_USER" env "${XENV[@]}" xsetroot -cursor_name left_ptr 2>/dev/null || true
}
cursor_hide() {
    pgrep -u "$KIOSK_USER" -f '^unclutter-xfixes' >/dev/null && return 0
    sudo -u "$KIOSK_USER" env "${XENV[@]}" sh -c 'unclutter-xfixes --start-hidden --hide-on-touch --timeout 1 --fork >/dev/null 2>&1' || true
}

# ---------- commands ----------
# version: major.minor.patch from VERSION in the repo, plus the git commit (and "+N" commits after the tag)
cmd_version() {
    local v g
    v="$(cat "${KIOSK_SYS}/VERSION" 2>/dev/null || echo 0.0.0)"
    g="$(git -C "$KIOSK_SYS" describe --always --dirty --tags 2>/dev/null || true)"
    echo "${v}${g:+ (${g})}"
}

# OS and update state for status: os_name, kernel, apt_upgradable (from update-notifier, else apt simulation), reboot_required, system_behind
os_state() {
    os_name="$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}")"; kernel="$(uname -r)"
    if [ -f /var/lib/update-notifier/updates-available ]; then
        apt_upgradable="$(grep -o '^[0-9]\+ update' /var/lib/update-notifier/updates-available | head -1 | cut -d' ' -f1)"
    fi
    [ -n "${apt_upgradable:-}" ] || apt_upgradable="$(timeout 8 apt-get -s -o Debug::NoLocking=true upgrade 2>/dev/null | grep -c '^Inst ' || echo '?')"
    reboot_required=no; [ -f /run/reboot-required ] && reboot_required=yes
    system_behind="$(git -C "$KIOSK_SYS" rev-list --count HEAD..@{u} 2>/dev/null || echo '?')"
    system_fetched="$(stat -c %y "$KIOSK_SYS/.git/FETCH_HEAD" 2>/dev/null | cut -d. -f1 || true)"
}

cmd_status() {
    local json=0; [ "${1:-}" = "--json" ] && json=1
    local os_name kernel apt_upgradable reboot_required system_behind system_fetched; os_state
    local host mode ver up ov ip temp session apps=()
    host="$(hostname)"; mode="$(persistence_mode)"; ver="$(cmd_version)"
    up="$(uptime -p | sed 's/^up //')"
    ov="$(overlayroot_active && echo yes || echo no)"
    ip="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | paste -sd' ' -)"
    temp="$(sensors 2>/dev/null | awk '/^(Package id 0|Tctl|Core 0|temp1)/ {gsub(/[+°C]/,"",$0); for(i=1;i<=NF;i++) if($i ~ /^[0-9.]+$/) {print $i; exit}}' | head -1)"
    session="$(systemctl is-active kiosk-session.service 2>/dev/null || true)"
    for n in $(app_names); do
        apps+=("$n:$(systemctl is-active "$(app_unit "$n")" 2>/dev/null || echo unknown)")
    done
    if [ "$json" -eq 1 ]; then
        printf '{"device":"%s","version":"%s","os":"%s","kernel":"%s","apt_upgradable":"%s","reboot_required":"%s","system_behind":"%s","uptime":"%s","persistence":"%s","overlay_active":"%s","ip":"%s","cpu_temp":"%s","mem_free_mb":%s,"disk_free_root_mb":%s,"disk_free_data_mb":%s,"session":"%s","services":{"tunnel":%s,"usb_action":%s,"monitoring":%s,"telegram":%s,"scheduler":%s},"apps":[' \
            "$host" "$ver" "$os_name" "$kernel" "$apt_upgradable" "$reboot_required" "$system_behind" "$up" "$mode" "$ov" "$ip" "$temp" \
            "$(free -m | awk '/^Mem:/ {print $7}')" "$(df -m --output=avail / | tail -1 | tr -d ' ')" "$(df -m --output=avail "$KIOSK_DIR" 2>/dev/null | tail -1 | tr -d ' ' || echo 0)" "$session" \
            "$(cfg '.services.tunnel.enabled' false)" "$(cfg '.services.usb_action.enabled' false)" "$(cfg '.services.monitoring.enabled' false)" "$(cfg '.services.telegram.enabled' false)" "$(cfg '.services.scheduler.enabled' false)"
        local first=1
        for a in "${apps[@]}"; do
            [ $first -eq 1 ] || printf ','
            printf '{"name":"%s","state":"%s","repos":%s}' "${a%%:*}" "${a#*:}" "$(cat "${KIOSK_DIR}/apps/${a%%:*}/state"/*.json 2>/dev/null | jq -sc 'map({name,commit,updated:.ts,size_mb,lfs,result})' 2>/dev/null || echo '[]')"; first=0
        done
        printf '],"ts":"%s"}\n' "$(date -Is)"
        return
    fi
    echo "=== Kiosk $host ==="
    echo "version:      $ver$([[ "$system_behind" =~ ^[0-9]+$ ]] && [ "$system_behind" -gt 0 ] && echo " ($system_behind commits behind origin${system_fetched:+, last fetch $system_fetched})")"
    echo "os:           $os_name, kernel $kernel"
    echo "updates:      $apt_upgradable packages upgradable$([ "$reboot_required" = yes ] && echo ", REBOOT REQUIRED")"
    echo "uptime:       $up"
    echo "persistence:  $mode (root overlay: $ov, /opt/kiosk: $(findmnt -n -o FSTYPE "$KIOSK_DIR" 2>/dev/null | tail -1 || echo "dir on root"))"
    echo "ip:           ${ip:-none}"
    echo "cpu temp:     ${temp:-n/a}"
    echo "memory:       $(free -m | awk '/^Mem:/ {printf "%d MB free of %d MB (%d%% used)", $7, $2, ($2-$7)*100/$2}')"
    echo "disk:         $(df -h --output=target,avail,size,pcent / "$KIOSK_DIR" 2>/dev/null | awk 'NR>1 {printf "%s %s free of %s (%s used)  ", $1, $2, $3, $4}' | sed 's/  $//')"
    echo "session:      $session"
    echo "services:"
    svc_line() {  # svc_line <label> <unit> <config-flag>: shows config state and unit state
        local st; st="$(systemctl is-active "$2" 2>/dev/null || true)"
        [ "$3" = "true" ] && printf '  %-16s on   %s\n' "$1" "$st" || printf '  %-16s off\n' "$1"
    }
    svc_line tunnel        kiosk-tunnel.service   "$(cfg '.services.tunnel.enabled' false)"
    svc_line app-update    "kiosk-content-update@*.timer" "$(systemctl list-timers --no-legend 'kiosk-content-update@*' 2>/dev/null | grep -q . && echo true || echo false)"
    svc_line usb-action    "" "$(cfg '.services.usb_action.enabled' false)"
    svc_line monitoring    kiosk-monitor.timer    "$(cfg '.services.monitoring.enabled' false)"
    svc_line telegram      kiosk-telegram.timer   "$(cfg '.services.telegram.enabled' false)"
    svc_line scheduler     kiosk-schedule-on.timer "$(cfg '.services.scheduler.enabled' false)"
    [ "$(cfg '.services.scheduler.enabled' false)" = true ] && echo "    state $([ -f "${KIOSK_STATE}/schedule" ] && cat "${KIOSK_STATE}/schedule" || echo -), next: $(systemctl list-timers --no-legend --no-pager 'kiosk-schedule-*' 2>/dev/null | awk '{print $1" "$2" "$3" "$NF}' | sed 's/.service//' | head -2 | paste -sd';' -)"
    echo "wifi:         $(cfg '.network.wifi | join(" ")' none) | active: $(nmcli -t -f NAME,DEVICE con show --active 2>/dev/null | grep '^kiosk-' | cut -d: -f1 | paste -sd' ' - || true)"
    echo "usb storage:  $([ "$(cfg '.security.disable_usb_storage' false)" = true ] && echo disabled || echo enabled)"
    echo "devmode:      $([ -f "${KIOSK_STATE}/devmode" ] && echo on || echo off)"
    echo "apps:"
    for a in "${apps[@]}"; do
        printf '  %-16s %s\n' "${a%%:*}" "${a#*:}"
        for f in "${KIOSK_DIR}/apps/${a%%:*}/state"/*.json; do
            [ -f "$f" ] || continue
            jq -r --argjson now "$(date +%s)" '
                def tsec: (.ts | .[0:19] + "Z" | fromdateiso8601) - ((.ts | .[19:]) as $o | if ($o | length) < 6 then 0 else (($o[1:3] | tonumber) * 3600 + ($o[4:6] | tonumber) * 60) * (if $o[0:1] == "-" then -1 else 1 end) end);
                def ago: (($now - tsec) as $s
                          | if $s < 90 then "\($s) s ago" elif $s < 5400 then "\($s/60|floor) min ago" elif $s < 172800 then "\($s/3600|floor) h ago" else "\($s/86400|floor) d ago" end);
                "    \(.name|.+"        "|.[0:8]) \(.commit // "-"|.+"       "|.[0:7]) \(try ago catch "?"|.+"            "|.[0:12]) \(.size_mb|tostring|.+" MB") \(if .lfs then "lfs" else "" end) \(if .result == "failed" then "FAILED" else "" end)"' "$f" 2>/dev/null
        done
    done
    if x_running; then
        echo "screens:"
        env "${XENV[@]}" xrandr --query | awk '/ connected/ {geo=($3=="primary")?$4:$3; printf "  %-10s %s %s\n", $1, geo, ($3=="primary")?"(primary)":""}'
    fi
}

cmd_history() {
    local n="${1:-20}"
    printf '%-25s %6s %6s %5s %5s %5s %6s %s\n' ts cpu gpu load mem% disk% fan restarts
    journalctl -t kiosk-monitor -o cat --no-pager -n "$n" 2>/dev/null | jq -r \
        '[.ts[0:19], (.cpu_temp // "-"), (.gpu_temp // "-"), (.load // "-"), (.mem_pct // "-"), (.disk_root // "-"), (.fan // "-"), (.restarts | to_entries | map(select(.value > 0) | "\(.key)=\(.value)") | join(" "))] | @tsv' \
        | awk -F'\t' '{printf "%-25s %6s %6s %5s %5s %5s %6s %s\n", $1,$2,$3,$4,$5,$6,$7,$8}'
}

cmd_doctor() {
    local ok=0 bad=0
    check() { if eval "$2" >/dev/null 2>&1; then echo "  ok    $1"; ok=$((ok+1)); else echo "  FAIL  $1"; bad=$((bad+1)); fi; }
    echo "doctor:"
    check "config exists and parses"        "yq -e '.' '$KIOSK_CONFIG'"
    check "kiosk user exists"               "id $KIOSK_USER"
    check "yq installed"                    "command -v yq"
    check "Xorg installed"                  "command -v X"
    check "openbox installed"               "command -v openbox"
    check "kiosk.target enabled"            "systemctl is-enabled kiosk.target"
    check "kiosk-session active"            "systemctl is-active kiosk-session.service"
    check "X server reachable"              "x_running"
    check "tty1 is the active console"      "[ \"\$(fgconsole 2>/dev/null)\" = 1 ]"
    for n in $(app_names); do
        local u; u="$(app_unit "$n")"
        check "unit template for app '$n' installed" "[ -f /etc/systemd/system/${u%%@*}@.service ]"
        check "app '$n' active"                       "systemctl is-active $u"
    done
    check "overlayroot installed"           "command -v overlayroot-chroot"
    if [ "$(persistence_mode)" = rw ]; then check "persistence rw: no overlay" "! overlayroot_active"; else check "persistence $(persistence_mode): overlay active" "overlayroot_active"; fi
    # findmnt lists stacked mounts bottom-up; the last line is the topmost (the overlay in locked mode)
    [ "$(persistence_mode)" = locked ] && check "locked: /opt/kiosk overlaid" "[ \"\$(findmnt -n -o FSTYPE $KIOSK_DIR | tail -1)\" = overlay ] || ! findmnt -n $KIOSK_DIR"
    check "sshd running"                    "systemctl is-active ssh"
    check "ufw active"                      "ufw status | grep -q 'Status: active'"
    check "sensors available"               "sensors"
    check "monitor timer enabled"           "systemctl is-enabled kiosk-monitor.timer"
    check "no failed repo sync"             "! cat ${KIOSK_DIR}/apps/*/state/*.json 2>/dev/null | jq -e 'select(.result==\"failed\")' >/dev/null"
    if [ -f /etc/opt/chrome/policies/managed/kiosk-extensions.json ]; then
        check "all forced extensions are served" "(for u in \$(jq -r '.ExtensionInstallForcelist[]' /etc/opt/chrome/policies/managed/kiosk-extensions.json | cut -d';' -f2); do curl -fsI --max-time 2 \"\$u\" >/dev/null || exit 1; done)"
    fi
    echo "  $ok ok, $bad failed"
    [ "$bad" -eq 0 ]
}

cmd_apply() {
    require_root
    [ -f "$KIOSK_CONFIG" ] || die "no config at $KIOSK_CONFIG"
    yq -e '.' "$KIOSK_CONFIG" >/dev/null || die "config is not valid YAML"
    local problems=0 wanted=() n t count i u

    # --- apps: render env files, enable/disable instances ---
    mkdir -p "${KIOSK_STATE}/apps"
    # global Chrome options for every web/static instance (read by apps/web/chrome-flags.sh)
    local cg cf
    cg="$(cfg '.chrome.gpu' auto)"; cf="$(cfg '(.chrome.flags // []) | join(" ")')"
    case "$cg" in auto|software) ;; *) warn "chrome.gpu must be auto or software"; cg=auto ;; esac
    printf 'CHROME_GPU=%s\nCHROME_FLAGS="%s"\n' "$cg" "${cf//\"/\\\"}" | write_file "${KIOSK_STATE}/chrome.env" 0644 || true
    if [ -f /etc/systemd/system/kiosk-web@.service ] || [ -f /etc/systemd/system/kiosk-static@.service ]; then
        "${KIOSK_SYS}/apps/web/extensions.sh" apply || problems=1
    fi
    count="$(cfg '.apps | length' 0)"
    for ((i=0; i<count; i++)); do
        n="$(cfg ".apps[$i].name")"; t="$(cfg ".apps[$i].type")"
        [ -n "$n" ] && [ -n "$t" ] || { warn "apps[$i]: name and type required"; problems=1; continue; }
        [[ "$n" =~ ^[a-z0-9_-]+$ ]] || { warn "app name '$n' must be [a-z0-9_-]"; problems=1; continue; }
        if [ ! -f "/etc/systemd/system/kiosk-${t}@.service" ]; then
            warn "app '$n': type '$t' is not installed, run: sudo ${KIOSK_SYS}/apps/${t}/install.sh"; problems=1; continue
        fi
        render_app_env "$i" | write_file "${KIOSK_STATE}/apps/${n}.env" 0644 || true
        if [ -x "${KIOSK_SYS}/apps/${t}/render.sh" ]; then
            "${KIOSK_SYS}/apps/${t}/render.sh" "$n" || { warn "render hook of '$n' failed"; problems=1; }
        fi
        wanted+=("kiosk-${t}@${n}.service")
        systemctl enable "kiosk-${t}@${n}.service" >/dev/null 2>&1 || true
    done
    # disable instances that are no longer configured
    while read -r u _; do
        [ -n "$u" ] || continue
        [[ " ${wanted[*]:-} " == *" $u "* ]] && continue
        log "removing app instance $u"
        systemctl disable --now "$u" >/dev/null 2>&1 || true
        n="${u#*@}"; n="${n%.service}"; t="${u#kiosk-}"; t="${t%%@*}"
        [ -x "${KIOSK_SYS}/apps/${t}/remove.sh" ] && "${KIOSK_SYS}/apps/${t}/remove.sh" "$n" || true
        rm -f "${KIOSK_STATE}/apps/${n}.env"
    done < <(systemctl list-units --all 'kiosk-*@*.service' --no-legend --plain 2>/dev/null | grep -v 'kiosk-content-update@')
    systemctl daemon-reload

    # --- display: live re-apply when X is up, restart apps ---
    if x_running; then
        [ "$(fgconsole 2>/dev/null)" = 1 ] || { chvt 1 && log "switched back to tty1 (a text console was active)"; }
        as_kiosk_x "${KIOSK_SYS}/display/apply-display.sh" || true
        if systemctl is-active kiosk.target >/dev/null 2>&1; then
            for u in "${wanted[@]:-}"; do [ -n "$u" ] && systemctl restart "$u" || true; done
        fi
    fi

    # --- services (each reads its own config section) ---
    local svc
    for svc in performance audio wifi tunnel usb security scheduler telegram; do
        [ -x "${KIOSK_SYS}/services/${svc}/apply.sh" ] || continue
        "${KIOSK_SYS}/services/${svc}/apply.sh" || { warn "service '$svc' apply failed"; problems=1; }
    done
    "${KIOSK_SYS}/monitoring/apply.sh" || { warn "monitoring apply failed"; problems=1; }

    # --- persistence: only report, the switch is explicit ---
    local want_mode cur_mode
    want_mode="$(cfg '.persistence.mode' rw)"; cur_mode="$(persistence_mode)"
    if [ "$want_mode" != "$cur_mode" ]; then
        log "persistence.mode is '$want_mode' but the system is '$cur_mode' — run: sudo kioskctl mount $want_mode"
    fi

    if [ "$problems" -eq 0 ]; then log "apply done"; else warn "apply finished with problems"; return 1; fi
}

cmd_app() {
    local sub="${1:-list}" n="${2:-}" x t
    case "$sub" in
        list) for x in $(app_names); do printf '%-16s %-28s %s\n' "$x" "$(app_unit "$x")" "$(systemctl is-active "$(app_unit "$x")" 2>/dev/null || true)"; done ;;
        start|stop|restart) [ -n "$n" ] || die "app name required"; systemctl "$sub" "$(app_unit "$n")" ;;
        logs) [ -n "$n" ] || die "app name required"; journalctl -u "$(app_unit "$n")" -n 100 --no-pager ;;
        update) require_root; [ -n "$n" ] || die "app name required"
                t="$(yq -r ".apps[] | select(.name==\"$n\") | .type" "$KIOSK_CONFIG")"
                [ -x "${KIOSK_SYS}/apps/${t}/update.sh" ] || die "app type '$t' has no update"
                "${KIOSK_SYS}/apps/${t}/update.sh" "$n" "${3:-}" ;;
        *) usage; exit 1 ;;
    esac
}

cmd_display() {
    x_running || die "X is not running"
    # a text console left active (Ctrl+Alt+F2) pauses X: nothing renders, new windows never map
    if [ "$(fgconsole 2>/dev/null)" != 1 ]; then chvt 1 && log "switched back to tty1"; fi
    as_kiosk_x "${KIOSK_SYS}/display/apply-display.sh"
}

cmd_storage() {
    local sub="${1:-status}"
    case "$sub" in
        status)
            if findmnt -n "$KIOSK_DIR" >/dev/null 2>&1; then
                echo "persistent volume: $(findmnt -n -o SOURCE,FSTYPE,SIZE,USED "$KIOSK_DIR")"
            else
                echo "no persistent volume: $KIOSK_DIR is a directory on the root filesystem"
            fi
            if command -v vgs >/dev/null; then
                echo "LVM free space: $(vgs --noheadings -o vg_name,vg_free 2>/dev/null | xargs || echo none)"
            fi ;;
        init)
            require_root
            overlayroot_active && die "switch to rw first (kioskctl mount rw, reboot)"
            findmnt -n "$KIOSK_DIR" >/dev/null 2>&1 && die "$KIOSK_DIR is already a mount point"
            local vg size="${2:-20G}" free tmp
            vg="$(vgs --noheadings -o vg_name 2>/dev/null | awk 'NR==1{print $1}')"
            [ -n "$vg" ] || die "no LVM volume group found; create a partition manually and add it to /etc/fstab at $KIOSK_DIR"
            free="$(vgs --noheadings --units g -o vg_free --nosuffix "$vg" | awk '{print int($1)}')"
            [ "$free" -ge 2 ] || die "volume group $vg has ${free}G free; shrink root offline or use another disk"
            [ "${size%G}" -le "$free" ] || size="${free}G"
            log "creating LV kiosk-data (${size}) in $vg"
            lvcreate -y -L "$size" -n kiosk-data "$vg"
            mkfs.ext4 -q -L kiosk-data "/dev/$vg/kiosk-data"
            tmp="$(mktemp -d)"
            mount "/dev/$vg/kiosk-data" "$tmp"
            cp -a "$KIOSK_DIR/." "$tmp/"
            umount "$tmp"; rmdir "$tmp"
            grep -q " $KIOSK_DIR " /etc/fstab || echo "/dev/$vg/kiosk-data  $KIOSK_DIR  ext4  defaults,noatime  0 2" >> /etc/fstab
            systemctl daemon-reload
            mount "$KIOSK_DIR"
            log "done: $KIOSK_DIR is now on /dev/$vg/kiosk-data (the old copy stays hidden under the mount)" ;;
        *) usage; exit 1 ;;
    esac
}

cmd_mount() {
    require_root
    local mode="${1:-}" overlay=0 journal=0 lock=0
    case "$mode" in
        rw)            ;;
        locked)        overlay=1; lock=1 ;;
        data)          overlay=1 ;;
        data+journal)  overlay=1; journal=1 ;;
        *) usage; exit 1 ;;
    esac
    if [ "$journal" = 1 ] && ! findmnt -n "$KIOSK_DIR" >/dev/null 2>&1; then
        die "mode '$mode' needs a persistent volume at $KIOSK_DIR; run: sudo kioskctl storage init"
    fi
    [ "$mode" = data ] && ! findmnt -n "$KIOSK_DIR" >/dev/null 2>&1 && warn "no volume at $KIOSK_DIR: 'data' behaves like 'locked' (everything is on the overlaid root)"

    # Written to the real root (through the chroot while an overlay is active) and, for update-grub,
    # also to the live system. /boot is a separate partition, so update-grub works live.
    local script
    # shellcheck disable=SC2016
    script='
        set -e
        mode="$1"; overlay="$2"; journal="$3"; lock="$4"; kdir="$5"; cfgf="$6"; sedexpr="$7"
        echo "$mode" > /etc/kiosk-persistence
        mkdir -p /etc/default/grub.d /etc/systemd/journald.conf.d
        if [ "$overlay" = 1 ]; then
            echo "overlayroot=\"tmpfs\"" > /etc/overlayroot.conf
            echo "GRUB_CMDLINE_LINUX_DEFAULT=\"\$GRUB_CMDLINE_LINUX_DEFAULT rd.overlay\"" > /etc/default/grub.d/90-kiosk-overlay.cfg
        else
            echo "overlayroot=\"\"" > /etc/overlayroot.conf
            rm -f /etc/default/grub.d/90-kiosk-overlay.cfg
        fi
        if [ "$journal" = 1 ]; then
            printf "[Journal]\nStorage=persistent\n" > /etc/systemd/journald.conf.d/20-kiosk-persistent.conf
            grep -q "/var/log/journal" /etc/fstab || echo "$kdir/logs/journal /var/log/journal none bind 0 0" >> /etc/fstab
        else
            rm -f /etc/systemd/journald.conf.d/20-kiosk-persistent.conf
            sed -i "\#/var/log/journal#d" /etc/fstab
        fi
        install -m 0644 /opt/kiosksystem/services/persistence/kiosk-locked.service /etc/systemd/system/
        mkdir -p /etc/systemd/system/local-fs.target.wants
        if [ "$lock" = 1 ]; then ln -sfn /etc/systemd/system/kiosk-locked.service /etc/systemd/system/local-fs.target.wants/kiosk-locked.service
        else rm -f /etc/systemd/system/local-fs.target.wants/kiosk-locked.service; fi
        [ -f "$cfgf" ] && [ ! -h "$cfgf" ] && sed -i -E "$sedexpr" "$cfgf" || true
        update-grub >/dev/null 2>&1 || echo "WARNING: update-grub failed" >&2
    '
    local sedexpr="/^persistence:/,/^[^ ]/{s/^(  mode:[ ]*)[^ #]+/\\1${mode}/}"
    mkdir -p "$KIOSK_DIR/logs/journal" 2>/dev/null || true
    # update-grub must run on the real root (grub-probe cannot handle an overlay root)
    run_on_real_root bash -c "$script" _ "$mode" "$overlay" "$journal" "$lock" "$KIOSK_DIR" "$KIOSK_CONFIG" "$sedexpr"
    overlayroot_active && echo "$mode" > /etc/kiosk-persistence
    # initramfs-tools systems read /etc/overlayroot.conf at boot; dracut systems use the kernel command line
    log "persistence mode set to '$mode'. Reboot to activate."
}

cmd_update() {
    require_root
    overlayroot_active && die "root is overlaid (mode $(persistence_mode)); run 'kioskctl mount rw' and reboot first"
    git -C "$KIOSK_SYS" pull --ff-only
    "${KIOSK_SYS}/setup.sh"
    # app types already installed get their installer again (new packages, units, policies)
    local t
    for t in "${KIOSK_SYS}"/apps/*/; do
        t="$(basename "$t")"
        [ -f "/etc/systemd/system/kiosk-${t}@.service" ] && [ -x "${KIOSK_SYS}/apps/${t}/install.sh" ] || continue
        log "re-running installer for app type '$t'"
        "${KIOSK_SYS}/apps/${t}/install.sh" || warn "installer for '$t' failed"
    done
    log "update done; reboot recommended"
}

# ---------- wifi (on-site) ----------
# Profile "onsite" sits below the configured service WLANs (priority 50) and is not managed by services/wifi.
cmd_wifi() {
    command -v nmcli >/dev/null || die "NetworkManager (nmcli) not installed"
    local sub="${1:-status}"; shift || true
    case "$sub" in
        status)
            [ "$(nmcli radio wifi)" = enabled ] || warn "radio is off (kioskctl wifi on)"
            nmcli -f DEVICE,TYPE,STATE,CONNECTION dev status | awk 'NR==1 || $2=="wifi"'
            local dev; dev="$(nmcli -t -f DEVICE,TYPE dev status | awk -F: '$2=="wifi" {print $1; exit}')"
            [ -n "$dev" ] || { warn "no wifi device"; return 0; }
            nmcli -t -f ACTIVE,SSID,SIGNAL,RATE,SECURITY dev wifi list ifname "$dev" 2>/dev/null | awk -F: '$1=="yes" {printf "link:   %s  signal %s%%  %s  %s\n", $2, $3, $4, $5}'
            nmcli -t -f IP4.ADDRESS,IP4.GATEWAY dev show "$dev" | sed 's/^IP4\./ip4 /; s/:/ = /' ;;
        scan)
            require_root
            nmcli dev wifi rescan >/dev/null 2>&1 || true; sleep 2
            nmcli -f IN-USE,SSID,SIGNAL,CHAN,SECURITY dev wifi list ;;
        connect)
            require_root
            local ssid="" psk="" hidden=no a
            for a in "$@"; do case "$a" in --hidden) hidden=yes ;; *) if [ -z "$ssid" ]; then ssid="$a"; else psk="$a"; fi ;; esac; done
            [ -n "$ssid" ] || die "usage: kioskctl wifi connect <ssid> [psk] [--hidden]"
            nmcli radio wifi on
            if [ -z "$psk" ] && [ -t 0 ]; then
                read -r -s -p "key for '$ssid' (empty = open network): " psk; echo
            fi
            nmcli con delete onsite >/dev/null 2>&1 || true
            nmcli dev wifi rescan >/dev/null 2>&1 || true
            nmcli con add type wifi con-name onsite ifname '*' ssid "$ssid" \
                connection.autoconnect yes connection.autoconnect-priority 50 wifi.hidden "$hidden" >/dev/null
            if [ -n "$psk" ]; then
                nmcli con modify onsite wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$psk" >/dev/null
            fi
            if nmcli -w 30 con up onsite >/dev/null 2>&1; then
                log "connected to '$ssid'"; cmd_wifi status
                [ "$(persistence_mode)" = rw ] || [ "$(persistence_mode)" = data ] || warn "persistence $(persistence_mode): the profile is gone after a reboot"
            else
                nmcli con delete onsite >/dev/null 2>&1 || true
                die "could not connect to '$ssid' (wrong key, out of range, or hidden: add --hidden)"
            fi ;;
        forget) require_root; nmcli con delete onsite >/dev/null 2>&1 && log "profile onsite removed" || warn "no onsite profile" ;;
        on|off) require_root; nmcli radio wifi "$sub"; log "radio $sub" ;;
        *) usage; exit 1 ;;
    esac
}

[ "${2:-}" = "--help" ] || [ "${2:-}" = "-h" ] && { cmd_help "$1"; exit 0; }
case "${1:-}" in
    status)   shift; cmd_status "$@" ;;
    history)  shift; cmd_history "$@" ;;
    metrics)  "${KIOSK_SYS}/monitoring/collect.sh" ;;
    heartbeat) require_root; "${KIOSK_SYS}/monitoring/heartbeat.sh" ;;
    doctor)   cmd_doctor ;;
    apply)    cmd_apply ;;
    app)      shift; cmd_app "$@" ;;
    display)  cmd_display ;;
    storage)  shift; cmd_storage "$@" ;;
    mount)    shift; cmd_mount "$@" ;;
    schedule) require_root; "${KIOSK_SYS}/services/scheduler/action.sh" "${2:-sync}" ;;
    test)     shift; case "${1:-}" in stress) shift; "${KIOSK_SYS}/tests/stress.sh" "$@" ;; *) usage; exit 1 ;; esac ;;
    bench)    shift; "${KIOSK_SYS}/tests/bench.sh" "$@" ;;
    devmode)  require_root
              case "${2:-}" in
                  on)  touch "${KIOSK_STATE}/devmode" ;;
                  off) rm -f "${KIOSK_STATE}/devmode" ;;
                  *) [ -f "${KIOSK_STATE}/devmode" ] && echo on || echo off; exit 0 ;;
              esac
              rc="${KIOSK_SYS}/display/openbox/rc.xml"; [ -f "${KIOSK_STATE}/devmode" ] && rc="${KIOSK_SYS}/display/openbox/rc-dev.xml"
              ln -sfn "$rc" "${KIOSK_STATE}/openbox-rc.xml"; chown -h "$KIOSK_USER:$KIOSK_USER" "${KIOSK_STATE}/openbox-rc.xml"
              x_running && sudo -u "$KIOSK_USER" env "${XENV[@]}" openbox --reconfigure >/dev/null 2>&1 || true
              if x_running; then [ "${2}" = on ] && cursor_show || cursor_hide; fi
              log "devmode ${2}" ;;
    secrets)  require_root
              case "${2:-}" in
                  git-key)
                      # git-key [label]: GitHub accepts a deploy key on one repo only, so use one key per repo,
                      # labelled <app>-app and <app>-data; without label the shared fallback key id_ed25519.
                      d="${KIOSK_SECRETS}/git"; install -d -m 0700 "$d"; touch "$d/known_hosts"
                      k="${3:-id_ed25519}"; [[ "$k" =~ ^[a-z0-9_-]+$ ]] || die "label must be [a-z0-9_-]"
                      [ -f "$d/$k" ] || { ssh-keygen -q -t ed25519 -N "" -C "kiosk-$(hostname)-$k" -f "$d/$k"; log "git deploy key '$k' generated"; }
                      echo "Add this as a read-only deploy key to the repo:"; cat "$d/$k.pub" ;;
                  list) ls -1 "${KIOSK_SECRETS}/git/"*.pub "${KIOSK_SECRETS}/tunnel/"*.pub 2>/dev/null || echo "no keys" ;;
                  tunnel-key) cat "${KIOSK_SECRETS}/tunnel/id_ed25519.pub" 2>/dev/null || die "no tunnel key yet (enable services.tunnel and apply)" ;;
                  *) echo "usage: kioskctl secrets git-key [label]|tunnel-key|list"; exit 1 ;;
              esac ;;
    screenshot) shift
              case "${1:-}" in
                  --telegram|-t) shift; require_root; "${KIOSK_SYS}/services/telegram/send.sh" "" "${1:-}" ;;
                  *) "${KIOSK_SYS}/tools/screenshot.sh" "${1:-}" ;;
              esac ;;
    files)    require_root; x_running || die "X is not running"
              command -v caja >/dev/null || die "caja not installed: sudo ${KIOSK_SYS}/tools/install.sh mate"
              cursor_show
              sudo -u "$KIOSK_USER" env "${XENV[@]}" XDG_RUNTIME_DIR="/run/user/$(id -u "$KIOSK_USER")" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$KIOSK_USER")/bus" \
                  setsid caja --no-desktop "${2:-/opt/kiosk}" >/dev/null 2>&1 < /dev/null &
              log "caja opened, cursor visible (close with Ctrl+Alt+Q in dev mode; hide the cursor again: kioskctl cursor hide)" ;;
    cursor)   require_root; x_running || die "X is not running"
              case "${2:-}" in show) cursor_show; log "cursor shown" ;; hide) cursor_hide; log "cursor hidden" ;; *) usage; exit 1 ;; esac ;;
    usb)      require_root
              case "${2:-list}" in
                  list)  lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS,TRAN -p | awk 'NR==1 || /usb/ || /^[├└│ ]/' ;;
                  mount) dev="${3:-$(lsblk -rno PATH,TYPE,TRAN,FSTYPE | awk '$2=="part" && $3=="usb" && $4!="" {print $1; exit}')}"
                         [ -n "$dev" ] || { lsblk -rno PATH,TYPE,TRAN,FSTYPE | awk '$2=="part" {print}'; die "no USB partition found"; }
                         mkdir -p /media/usb; mount -o uid="$(id -u "$KIOSK_USER")",gid="$(id -g "$KIOSK_USER")" "$dev" /media/usb 2>/dev/null || mount "$dev" /media/usb
                         log "$dev mounted at /media/usb (kioskctl usb umount when done)" ;;
                  umount) sync; umount /media/usb && log "unmounted" ;;
                  *) usage; exit 1 ;;
              esac ;;
    wifi)     cmd_wifi "${@:2}" ;;
    extension|ext) "${KIOSK_SYS}/apps/web/extensions.sh" "${@:2}" ;;
    update)   cmd_update ;;
    version)  cmd_version ;;
    -h|--help|help|"") cmd_help "${2:-}" ;;
    *) usage; exit 1 ;;
esac
