#!/usr/bin/env bash
# kioskctl — control CLI for the kiosk system.
set -euo pipefail
source /opt/kiosksystem/lib/common.sh
LOG_TAG="kioskctl"

usage() {
    cat <<'U'
Usage: kioskctl <command>

  status [--json]            summary of this kiosk
  history [N]                last N metric lines from the journal (default 20)
  metrics                    collect metrics now (JSON)
  heartbeat                  send a heartbeat now
  doctor                     check every component
  apply                      validate kiosk.yaml and apply apps, display, persistence config
  app list|start|stop|restart|logs|update [name]
  display                    re-apply screen layout and touch mapping now
  storage status|init [SIZE] persistent volume for /opt/kiosk (default 20G)
  mount <rw|locked|data|data+journal>   set persistence mode (reboot required)
  schedule on|off|sync       run a scheduler action now
  test stress [min] [eps]    simulate usage, sample memory (tests/stress.sh)
  bench info|gpu|motionmark  benchmarks (tests/bench.sh)
  devmode on|off             escape hotkeys in the session (Ctrl+Alt+T terminal), reconfigures openbox
  screenshot [file]          save a screenshot (default /opt/kiosk/data/screenshots/)
  screenshot --telegram [caption]   send a screenshot to the configured Telegram chat
  files [dir]                open caja on the kiosk screen with a visible cursor (needs tools/install.sh mate)
  cursor show|hide           show or hide the mouse pointer
  usb list|mount [dev]|umount  USB sticks: list, mount at /media/usb, unmount
  secrets git-key [label]    generate/show a deploy key for a private repo (label e.g. menu-app, menu-data)
  secrets tunnel-key|list    show the tunnel key / list all public keys
  update                     git pull system repo, re-run setup, re-apply
  version
U
}

XENV=(DISPLAY=:0 XAUTHORITY="/home/${KIOSK_USER}/.Xauthority")

# ---------- helpers ----------
app_names() { yq -r '.apps[]?.name' "$KIOSK_CONFIG" 2>/dev/null || true; }
app_unit()  { local n="$1" t; t="$(yq -r ".apps[] | select(.name==\"$n\") | .type" "$KIOSK_CONFIG")"; echo "kiosk-${t}@${n}.service"; }
persistence_mode() { cat /etc/kiosk-persistence 2>/dev/null || echo rw; }
x_running() { env "${XENV[@]}" xset q >/dev/null 2>&1; }
as_kiosk_x() { sudo -u "$KIOSK_USER" env "${XENV[@]}" "$@"; }

# render_app_env <index>   Prints APP_<KEY>=value for every scalar key of apps[index],
# plus defaults for screen and geometry. Lists and maps are skipped.
render_app_env() {
    local i="$1" key val
    echo "APP_SCREEN=primary"
    echo "APP_GEOMETRY=fullscreen"
    while read -r key; do
        [ -n "$key" ] || continue
        [[ "$key" =~ ^[a-z0-9_]+$ ]] || { warn "apps[$i]: key '$key' ignored (use a-z, 0-9, _)"; continue; }
        case "$(yq -r ".apps[$i].${key} | type" "$KIOSK_CONFIG")" in
            array|object) continue ;;
        esac
        val="$(cfg ".apps[$i].${key}")"
        val="${val//\\/\\\\}"; val="${val//\"/\\\"}"
        echo "APP_${key^^}=\"${val}\""
    done < <(yq -r ".apps[$i] | keys | .[]" "$KIOSK_CONFIG")
}

# cursor_show / cursor_hide: the kiosk session hides the pointer (unclutter-xfixes); dev tools need it
cursor_show() {
    # -x cannot match names longer than 15 characters; match the start of the command line instead
    pkill -u "$KIOSK_USER" -f '^unclutter-xfixes' 2>/dev/null || true
    sudo -u "$KIOSK_USER" env "${XENV[@]}" xsetroot -cursor_name left_ptr 2>/dev/null || true
}
cursor_hide() {
    pgrep -u "$KIOSK_USER" -f '^unclutter-xfixes' >/dev/null && return 0
    sudo -u "$KIOSK_USER" env "${XENV[@]}" sh -c 'unclutter-xfixes --start-hidden --hide-on-touch --timeout 1 --fork >/dev/null 2>&1' || true
}

# ---------- commands ----------
# version: major.minor.patch from VERSION in the repo, plus the git commit (and "+N" commits after the tag)
cmd_version() {
    local v g
    v="$(cat "${KIOSK_SYS}/VERSION" 2>/dev/null || echo 0.0.0)"
    g="$(git -C "$KIOSK_SYS" describe --always --dirty --tags 2>/dev/null || true)"
    echo "${v}${g:+ (${g})}"
}

cmd_status() {
    local json=0; [ "${1:-}" = "--json" ] && json=1
    local host mode ver up ov ip temp session apps=()
    host="$(hostname)"; mode="$(persistence_mode)"; ver="$(cmd_version)"
    up="$(uptime -p | sed 's/^up //')"
    ov="$(overlayroot_active && echo yes || echo no)"
    ip="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | paste -sd' ' -)"
    temp="$(sensors 2>/dev/null | awk '/^(Package id 0|Tctl|Core 0|temp1)/ {gsub(/[+°C]/,"",$0); for(i=1;i<=NF;i++) if($i ~ /^[0-9.]+$/) {print $i; exit}}' | head -1)"
    session="$(systemctl is-active kiosk-session.service 2>/dev/null || true)"
    for n in $(app_names); do
        apps+=("$n:$(systemctl is-active "$(app_unit "$n")" 2>/dev/null || echo unknown)")
    done
    if [ "$json" -eq 1 ]; then
        printf '{"device":"%s","version":"%s","uptime":"%s","persistence":"%s","overlay_active":"%s","ip":"%s","cpu_temp":"%s","session":"%s","services":{"tunnel":%s,"usb_action":%s,"monitoring":%s,"telegram":%s,"scheduler":%s},"apps":[' \
            "$host" "$ver" "$up" "$mode" "$ov" "$ip" "$temp" "$session" \
            "$(cfg '.services.tunnel.enabled' false)" "$(cfg '.services.usb_action.enabled' false)" "$(cfg '.services.monitoring.enabled' false)" "$(cfg '.services.telegram.enabled' false)" "$(cfg '.services.scheduler.enabled' false)"
        local first=1
        for a in "${apps[@]}"; do
            [ $first -eq 1 ] || printf ','
            printf '{"name":"%s","state":"%s"}' "${a%%:*}" "${a#*:}"; first=0
        done
        printf '],"ts":"%s"}\n' "$(date -Is)"
        return
    fi
    echo "=== Kiosk $host ==="
    echo "version:      $ver"
    echo "uptime:       $up"
    echo "persistence:  $mode (root overlay: $ov, /opt/kiosk: $(findmnt -n -o FSTYPE "$KIOSK_DIR" 2>/dev/null | tail -1 || echo "dir on root"))"
    echo "ip:           ${ip:-none}"
    echo "cpu temp:     ${temp:-n/a}"
    echo "session:      $session"
    echo "services:"
    svc_line() {  # svc_line <label> <unit> <config-flag>: shows config state and unit state
        local st; st="$(systemctl is-active "$2" 2>/dev/null || true)"
        [ "$3" = "true" ] && printf '  %-16s on   %s\n' "$1" "$st" || printf '  %-16s off\n' "$1"
    }
    svc_line tunnel        kiosk-tunnel.service   "$(cfg '.services.tunnel.enabled' false)"
    svc_line app-update    "kiosk-content-update@*.timer" "$(systemctl list-timers --no-legend 'kiosk-content-update@*' 2>/dev/null | grep -q . && echo true || echo false)"
    svc_line usb-action    "" "$(cfg '.services.usb_action.enabled' false)"
    svc_line monitoring    kiosk-monitor.timer    "$(cfg '.services.monitoring.enabled' false)"
    svc_line telegram      kiosk-telegram.timer   "$(cfg '.services.telegram.enabled' false)"
    svc_line scheduler     kiosk-schedule-on.timer "$(cfg '.services.scheduler.enabled' false)"
    [ "$(cfg '.services.scheduler.enabled' false)" = true ] && echo "    state $([ -f "${KIOSK_STATE}/schedule" ] && cat "${KIOSK_STATE}/schedule" || echo -), next: $(systemctl list-timers --no-legend --no-pager 'kiosk-schedule-*' 2>/dev/null | awk '{print $1" "$2" "$3" "$NF}' | sed 's/.service//' | head -2 | paste -sd';' -)"
    echo "wifi:         $(cfg '.network.wifi | join(" ")' none) | active: $(nmcli -t -f NAME,DEVICE con show --active 2>/dev/null | grep '^kiosk-' | cut -d: -f1 | paste -sd' ' - || true)"
    echo "usb storage:  $([ "$(cfg '.security.disable_usb_storage' false)" = true ] && echo disabled || echo enabled)"
    echo "devmode:      $([ -f "${KIOSK_STATE}/devmode" ] && echo on || echo off)"
    echo "apps:"
    for a in "${apps[@]}"; do printf '  %-16s %s\n' "${a%%:*}" "${a#*:}"; done
    if x_running; then
        echo "screens:"
        env "${XENV[@]}" xrandr --query | awk '/ connected/ {geo=($3=="primary")?$4:$3; printf "  %-10s %s %s\n", $1, geo, ($3=="primary")?"(primary)":""}'
    fi
}

cmd_history() {
    local n="${1:-20}"
    printf '%-25s %6s %6s %5s %5s %5s %6s %s\n' ts cpu gpu load mem% disk% fan restarts
    journalctl -t kiosk-monitor -o cat --no-pager -n "$n" 2>/dev/null | jq -r \
        '[.ts[0:19], (.cpu_temp // "-"), (.gpu_temp // "-"), (.load // "-"), (.mem_pct // "-"), (.disk_root // "-"), (.fan // "-"), (.restarts | to_entries | map(select(.value > 0) | "\(.key)=\(.value)") | join(" "))] | @tsv' \
        | awk -F'\t' '{printf "%-25s %6s %6s %5s %5s %5s %6s %s\n", $1,$2,$3,$4,$5,$6,$7,$8}'
}

cmd_doctor() {
    local ok=0 bad=0
    check() { if eval "$2" >/dev/null 2>&1; then echo "  ok    $1"; ok=$((ok+1)); else echo "  FAIL  $1"; bad=$((bad+1)); fi; }
    echo "doctor:"
    check "config exists and parses"        "yq -e '.' '$KIOSK_CONFIG'"
    check "kiosk user exists"               "id $KIOSK_USER"
    check "yq installed"                    "command -v yq"
    check "Xorg installed"                  "command -v X"
    check "openbox installed"               "command -v openbox"
    check "kiosk.target enabled"            "systemctl is-enabled kiosk.target"
    check "kiosk-session active"            "systemctl is-active kiosk-session.service"
    check "X server reachable"              "x_running"
    check "tty1 is the active console"      "[ \"\$(fgconsole 2>/dev/null)\" = 1 ]"
    for n in $(app_names); do
        local u; u="$(app_unit "$n")"
        check "unit template for app '$n' installed" "[ -f /etc/systemd/system/${u%%@*}@.service ]"
        check "app '$n' active"                       "systemctl is-active $u"
    done
    check "overlayroot installed"           "command -v overlayroot-chroot"
    if [ "$(persistence_mode)" = rw ]; then check "persistence rw: no overlay" "! overlayroot_active"; else check "persistence $(persistence_mode): overlay active" "overlayroot_active"; fi
    # findmnt lists stacked mounts bottom-up; the last line is the topmost (the overlay in locked mode)
    [ "$(persistence_mode)" = locked ] && check "locked: /opt/kiosk overlaid" "[ \"\$(findmnt -n -o FSTYPE $KIOSK_DIR | tail -1)\" = overlay ] || ! findmnt -n $KIOSK_DIR"
    check "sshd running"                    "systemctl is-active ssh"
    check "ufw active"                      "ufw status | grep -q 'Status: active'"
    check "sensors available"               "sensors"
    check "monitor timer enabled"           "systemctl is-enabled kiosk-monitor.timer"
    echo "  $ok ok, $bad failed"
    [ "$bad" -eq 0 ]
}

cmd_apply() {
    require_root
    [ -f "$KIOSK_CONFIG" ] || die "no config at $KIOSK_CONFIG"
    yq -e '.' "$KIOSK_CONFIG" >/dev/null || die "config is not valid YAML"
    local problems=0 wanted=() n t count i u

    # --- apps: render env files, enable/disable instances ---
    mkdir -p "${KIOSK_STATE}/apps"
    count="$(cfg '.apps | length' 0)"
    for ((i=0; i<count; i++)); do
        n="$(cfg ".apps[$i].name")"; t="$(cfg ".apps[$i].type")"
        [ -n "$n" ] && [ -n "$t" ] || { warn "apps[$i]: name and type required"; problems=1; continue; }
        [[ "$n" =~ ^[a-z0-9_-]+$ ]] || { warn "app name '$n' must be [a-z0-9_-]"; problems=1; continue; }
        if [ ! -f "/etc/systemd/system/kiosk-${t}@.service" ]; then
            warn "app '$n': type '$t' is not installed, run: sudo ${KIOSK_SYS}/apps/${t}/install.sh"; problems=1; continue
        fi
        render_app_env "$i" | write_file "${KIOSK_STATE}/apps/${n}.env" 0644 || true
        if [ -x "${KIOSK_SYS}/apps/${t}/render.sh" ]; then
            "${KIOSK_SYS}/apps/${t}/render.sh" "$n" || { warn "render hook of '$n' failed"; problems=1; }
        fi
        wanted+=("kiosk-${t}@${n}.service")
        systemctl enable "kiosk-${t}@${n}.service" >/dev/null 2>&1 || true
    done
    # disable instances that are no longer configured
    while read -r u _; do
        [ -n "$u" ] || continue
        [[ " ${wanted[*]:-} " == *" $u "* ]] && continue
        log "removing app instance $u"
        systemctl disable --now "$u" >/dev/null 2>&1 || true
        n="${u#*@}"; n="${n%.service}"; t="${u#kiosk-}"; t="${t%%@*}"
        [ -x "${KIOSK_SYS}/apps/${t}/remove.sh" ] && "${KIOSK_SYS}/apps/${t}/remove.sh" "$n" || true
        rm -f "${KIOSK_STATE}/apps/${n}.env"
    done < <(systemctl list-units --all 'kiosk-*@*.service' --no-legend --plain 2>/dev/null | grep -v 'kiosk-content-update@')
    systemctl daemon-reload

    # --- display: live re-apply when X is up, restart apps ---
    if x_running; then
        [ "$(fgconsole 2>/dev/null)" = 1 ] || { chvt 1 && log "switched back to tty1 (a text console was active)"; }
        as_kiosk_x "${KIOSK_SYS}/display/apply-display.sh" || true
        if systemctl is-active kiosk.target >/dev/null 2>&1; then
            for u in "${wanted[@]:-}"; do [ -n "$u" ] && systemctl restart "$u" || true; done
        fi
    fi

    # --- services (each reads its own config section) ---
    local svc
    for svc in audio wifi tunnel usb security scheduler telegram; do
        [ -x "${KIOSK_SYS}/services/${svc}/apply.sh" ] || continue
        "${KIOSK_SYS}/services/${svc}/apply.sh" || { warn "service '$svc' apply failed"; problems=1; }
    done
    "${KIOSK_SYS}/monitoring/apply.sh" || { warn "monitoring apply failed"; problems=1; }

    # --- persistence: only report, the switch is explicit ---
    local want_mode cur_mode
    want_mode="$(cfg '.persistence.mode' rw)"; cur_mode="$(persistence_mode)"
    if [ "$want_mode" != "$cur_mode" ]; then
        log "persistence.mode is '$want_mode' but the system is '$cur_mode' — run: sudo kioskctl mount $want_mode"
    fi

    if [ "$problems" -eq 0 ]; then log "apply done"; else warn "apply finished with problems"; return 1; fi
}

cmd_app() {
    local sub="${1:-list}" n="${2:-}" x t
    case "$sub" in
        list) for x in $(app_names); do printf '%-16s %-28s %s\n' "$x" "$(app_unit "$x")" "$(systemctl is-active "$(app_unit "$x")" 2>/dev/null || true)"; done ;;
        start|stop|restart) [ -n "$n" ] || die "app name required"; systemctl "$sub" "$(app_unit "$n")" ;;
        logs) [ -n "$n" ] || die "app name required"; journalctl -u "$(app_unit "$n")" -n 100 --no-pager ;;
        update) require_root; [ -n "$n" ] || die "app name required"
                t="$(yq -r ".apps[] | select(.name==\"$n\") | .type" "$KIOSK_CONFIG")"
                [ -x "${KIOSK_SYS}/apps/${t}/update.sh" ] || die "app type '$t' has no update"
                "${KIOSK_SYS}/apps/${t}/update.sh" "$n" ;;
        *) usage; exit 1 ;;
    esac
}

cmd_display() {
    x_running || die "X is not running"
    # a text console left active (Ctrl+Alt+F2) pauses X: nothing renders, new windows never map
    if [ "$(fgconsole 2>/dev/null)" != 1 ]; then chvt 1 && log "switched back to tty1"; fi
    as_kiosk_x "${KIOSK_SYS}/display/apply-display.sh"
}

cmd_storage() {
    local sub="${1:-status}"
    case "$sub" in
        status)
            if findmnt -n "$KIOSK_DIR" >/dev/null 2>&1; then
                echo "persistent volume: $(findmnt -n -o SOURCE,FSTYPE,SIZE,USED "$KIOSK_DIR")"
            else
                echo "no persistent volume: $KIOSK_DIR is a directory on the root filesystem"
            fi
            if command -v vgs >/dev/null; then
                echo "LVM free space: $(vgs --noheadings -o vg_name,vg_free 2>/dev/null | xargs || echo none)"
            fi ;;
        init)
            require_root
            overlayroot_active && die "switch to rw first (kioskctl mount rw, reboot)"
            findmnt -n "$KIOSK_DIR" >/dev/null 2>&1 && die "$KIOSK_DIR is already a mount point"
            local vg size="${2:-20G}" free tmp
            vg="$(vgs --noheadings -o vg_name 2>/dev/null | awk 'NR==1{print $1}')"
            [ -n "$vg" ] || die "no LVM volume group found; create a partition manually and add it to /etc/fstab at $KIOSK_DIR"
            free="$(vgs --noheadings --units g -o vg_free --nosuffix "$vg" | awk '{print int($1)}')"
            [ "$free" -ge 2 ] || die "volume group $vg has ${free}G free; shrink root offline or use another disk"
            [ "${size%G}" -le "$free" ] || size="${free}G"
            log "creating LV kiosk-data (${size}) in $vg"
            lvcreate -y -L "$size" -n kiosk-data "$vg"
            mkfs.ext4 -q -L kiosk-data "/dev/$vg/kiosk-data"
            tmp="$(mktemp -d)"
            mount "/dev/$vg/kiosk-data" "$tmp"
            cp -a "$KIOSK_DIR/." "$tmp/"
            umount "$tmp"; rmdir "$tmp"
            grep -q " $KIOSK_DIR " /etc/fstab || echo "/dev/$vg/kiosk-data  $KIOSK_DIR  ext4  defaults,noatime  0 2" >> /etc/fstab
            systemctl daemon-reload
            mount "$KIOSK_DIR"
            log "done: $KIOSK_DIR is now on /dev/$vg/kiosk-data (the old copy stays hidden under the mount)" ;;
        *) usage; exit 1 ;;
    esac
}

cmd_mount() {
    require_root
    local mode="${1:-}" overlay=0 journal=0 lock=0
    case "$mode" in
        rw)            ;;
        locked)        overlay=1; lock=1 ;;
        data)          overlay=1 ;;
        data+journal)  overlay=1; journal=1 ;;
        *) usage; exit 1 ;;
    esac
    if [ "$journal" = 1 ] && ! findmnt -n "$KIOSK_DIR" >/dev/null 2>&1; then
        die "mode '$mode' needs a persistent volume at $KIOSK_DIR; run: sudo kioskctl storage init"
    fi
    [ "$mode" = data ] && ! findmnt -n "$KIOSK_DIR" >/dev/null 2>&1 && warn "no volume at $KIOSK_DIR: 'data' behaves like 'locked' (everything is on the overlaid root)"

    # Written to the real root (through the chroot while an overlay is active) and, for update-grub,
    # also to the live system. /boot is a separate partition, so update-grub works live.
    local script
    # shellcheck disable=SC2016
    script='
        set -e
        mode="$1"; overlay="$2"; journal="$3"; lock="$4"; kdir="$5"; cfgf="$6"; sedexpr="$7"
        echo "$mode" > /etc/kiosk-persistence
        mkdir -p /etc/default/grub.d /etc/systemd/journald.conf.d
        if [ "$overlay" = 1 ]; then
            echo "overlayroot=\"tmpfs\"" > /etc/overlayroot.conf
            echo "GRUB_CMDLINE_LINUX_DEFAULT=\"\$GRUB_CMDLINE_LINUX_DEFAULT rd.overlay\"" > /etc/default/grub.d/90-kiosk-overlay.cfg
        else
            echo "overlayroot=\"\"" > /etc/overlayroot.conf
            rm -f /etc/default/grub.d/90-kiosk-overlay.cfg
        fi
        if [ "$journal" = 1 ]; then
            printf "[Journal]\nStorage=persistent\n" > /etc/systemd/journald.conf.d/20-kiosk-persistent.conf
            grep -q "/var/log/journal" /etc/fstab || echo "$kdir/logs/journal /var/log/journal none bind 0 0" >> /etc/fstab
        else
            rm -f /etc/systemd/journald.conf.d/20-kiosk-persistent.conf
            sed -i "\#/var/log/journal#d" /etc/fstab
        fi
        install -m 0644 /opt/kiosksystem/services/persistence/kiosk-locked.service /etc/systemd/system/
        mkdir -p /etc/systemd/system/local-fs.target.wants
        if [ "$lock" = 1 ]; then ln -sfn /etc/systemd/system/kiosk-locked.service /etc/systemd/system/local-fs.target.wants/kiosk-locked.service
        else rm -f /etc/systemd/system/local-fs.target.wants/kiosk-locked.service; fi
        [ -f "$cfgf" ] && [ ! -h "$cfgf" ] && sed -i -E "$sedexpr" "$cfgf" || true
        update-grub >/dev/null 2>&1 || echo "WARNING: update-grub failed" >&2
    '
    local sedexpr="/^persistence:/,/^[^ ]/{s/^(  mode:[ ]*)[^ #]+/\\1${mode}/}"
    mkdir -p "$KIOSK_DIR/logs/journal" 2>/dev/null || true
    # update-grub must run on the real root (grub-probe cannot handle an overlay root)
    run_on_real_root bash -c "$script" _ "$mode" "$overlay" "$journal" "$lock" "$KIOSK_DIR" "$KIOSK_CONFIG" "$sedexpr"
    overlayroot_active && echo "$mode" > /etc/kiosk-persistence
    # initramfs-tools systems read /etc/overlayroot.conf at boot; dracut systems use the kernel command line
    log "persistence mode set to '$mode'. Reboot to activate."
}

cmd_update() {
    require_root
    overlayroot_active && die "root is overlaid (mode $(persistence_mode)); run 'kioskctl mount rw' and reboot first"
    git -C "$KIOSK_SYS" pull --ff-only
    "${KIOSK_SYS}/setup.sh"
    log "update done; reboot recommended"
}

case "${1:-}" in
    status)   shift; cmd_status "$@" ;;
    history)  shift; cmd_history "$@" ;;
    metrics)  "${KIOSK_SYS}/monitoring/collect.sh" ;;
    heartbeat) require_root; "${KIOSK_SYS}/monitoring/heartbeat.sh" ;;
    doctor)   cmd_doctor ;;
    apply)    cmd_apply ;;
    app)      shift; cmd_app "$@" ;;
    display)  cmd_display ;;
    storage)  shift; cmd_storage "$@" ;;
    mount)    shift; cmd_mount "$@" ;;
    schedule) require_root; "${KIOSK_SYS}/services/scheduler/action.sh" "${2:-sync}" ;;
    test)     shift; case "${1:-}" in stress) shift; "${KIOSK_SYS}/tests/stress.sh" "$@" ;; *) usage; exit 1 ;; esac ;;
    bench)    shift; "${KIOSK_SYS}/tests/bench.sh" "$@" ;;
    devmode)  require_root
              case "${2:-}" in
                  on)  touch "${KIOSK_STATE}/devmode" ;;
                  off) rm -f "${KIOSK_STATE}/devmode" ;;
                  *) [ -f "${KIOSK_STATE}/devmode" ] && echo on || echo off; exit 0 ;;
              esac
              rc="${KIOSK_SYS}/display/openbox/rc.xml"; [ -f "${KIOSK_STATE}/devmode" ] && rc="${KIOSK_SYS}/display/openbox/rc-dev.xml"
              ln -sfn "$rc" "${KIOSK_STATE}/openbox-rc.xml"; chown -h "$KIOSK_USER:$KIOSK_USER" "${KIOSK_STATE}/openbox-rc.xml"
              x_running && sudo -u "$KIOSK_USER" env "${XENV[@]}" openbox --reconfigure >/dev/null 2>&1 || true
              if x_running; then [ "${2}" = on ] && cursor_show || cursor_hide; fi
              log "devmode ${2}" ;;
    secrets)  require_root
              case "${2:-}" in
                  git-key)
                      # git-key [label]: GitHub accepts a deploy key on one repo only, so use one key per repo,
                      # labelled <app>-app and <app>-data; without label the shared fallback key id_ed25519.
                      d="${KIOSK_SECRETS}/git"; install -d -m 0700 "$d"; touch "$d/known_hosts"
                      k="${3:-id_ed25519}"; [[ "$k" =~ ^[a-z0-9_-]+$ ]] || die "label must be [a-z0-9_-]"
                      [ -f "$d/$k" ] || { ssh-keygen -q -t ed25519 -N "" -C "kiosk-$(hostname)-$k" -f "$d/$k"; log "git deploy key '$k' generated"; }
                      echo "Add this as a read-only deploy key to the repo:"; cat "$d/$k.pub" ;;
                  list) ls -1 "${KIOSK_SECRETS}/git/"*.pub "${KIOSK_SECRETS}/tunnel/"*.pub 2>/dev/null || echo "no keys" ;;
                  tunnel-key) cat "${KIOSK_SECRETS}/tunnel/id_ed25519.pub" 2>/dev/null || die "no tunnel key yet (enable services.tunnel and apply)" ;;
                  *) echo "usage: kioskctl secrets git-key [label]|tunnel-key|list"; exit 1 ;;
              esac ;;
    screenshot) shift
              case "${1:-}" in
                  --telegram|-t) shift; require_root; "${KIOSK_SYS}/services/telegram/send.sh" "" "${1:-}" ;;
                  *) "${KIOSK_SYS}/tools/screenshot.sh" "${1:-}" ;;
              esac ;;
    files)    require_root; x_running || die "X is not running"
              command -v caja >/dev/null || die "caja not installed: sudo ${KIOSK_SYS}/tools/install.sh mate"
              cursor_show
              sudo -u "$KIOSK_USER" env "${XENV[@]}" XDG_RUNTIME_DIR="/run/user/$(id -u "$KIOSK_USER")" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$KIOSK_USER")/bus" \
                  setsid caja --no-desktop "${2:-/opt/kiosk}" >/dev/null 2>&1 < /dev/null &
              log "caja opened, cursor visible (close with Ctrl+Alt+Q in dev mode; hide the cursor again: kioskctl cursor hide)" ;;
    cursor)   require_root; x_running || die "X is not running"
              case "${2:-}" in show) cursor_show; log "cursor shown" ;; hide) cursor_hide; log "cursor hidden" ;; *) usage; exit 1 ;; esac ;;
    usb)      require_root
              case "${2:-list}" in
                  list)  lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS,TRAN -p | awk 'NR==1 || /usb/ || /^[├└│ ]/' ;;
                  mount) dev="${3:-$(lsblk -rno PATH,TYPE,TRAN,FSTYPE | awk '$2=="part" && $3=="usb" && $4!="" {print $1; exit}')}"
                         [ -n "$dev" ] || { lsblk -rno PATH,TYPE,TRAN,FSTYPE | awk '$2=="part" {print}'; die "no USB partition found"; }
                         mkdir -p /media/usb; mount -o uid="$(id -u "$KIOSK_USER")",gid="$(id -g "$KIOSK_USER")" "$dev" /media/usb 2>/dev/null || mount "$dev" /media/usb
                         log "$dev mounted at /media/usb (kioskctl usb umount when done)" ;;
                  umount) sync; umount /media/usb && log "unmounted" ;;
                  *) usage; exit 1 ;;
              esac ;;
    update)   cmd_update ;;
    version)  cmd_version ;;
    -h|--help|help|"") usage ;;
    *) usage; exit 1 ;;
esac
